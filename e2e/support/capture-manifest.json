  "states": [
    {
      "id": "login_locale_en",
      "base_screen": "login",
      "url": "/login",
      "label": "Tela de login em inglês",
      "steps": [
        {
          "action": "click",
          "selector": "[data-testid=\"locale-toggle\"]"
        }
      ],
      "proof": "text=Welcome back",
      "why": "A página inteira muda para inglês (heading, labels, botões), estado que uma visita única não captura."
    },
    {
      "id": "login_auth_error",
      "base_screen": "login",
      "url": "/login",
      "label": "Erro de autenticação no login",
      "steps": [
        {
          "action": "fill",
          "selector": "[data-testid=\"email-input\"]",
          "value": "test@example.com"
        },
        {
          "action": "fill",
          "selector": "[data-testid=\"password-input\"]",
          "value": "password123"
        },
        {
          "action": "click",
          "selector": "[data-testid=\"submit-login\"]"
        }
      ],
      "proof": "[data-testid=\"login-error\"]",
      "why": "Mensagem de erro inline que aparece após submissão com credenciais inválidas (backend stub falha)."
    },
    {
      "id": "otp_step2_code_input",
      "base_screen": "otp",
      "url": "/auth/code",
      "label": "Segundo passo do OTP: inserir código",
      "steps": [
        {
          "action": "fill",
          "selector": "[data-testid=\"otp-email-input\"]",
          "value": "test@example.com"
        },
        {
          "action": "click",
          "selector": "[data-testid=\"submit-otp-send\"]"
        }
      ],
      "proof": "[data-testid=\"otp-code-input\"]",
      "why": "Formulário multi-step: após enviar o email, a tela muda para input de código de 6 dígitos + botões Entrar e Reenviar código."
    },
    {
      "id": "otp_invalid_code_error",
      "base_screen": "otp",
      "url": "/auth/code",
      "label": "Erro de código OTP inválido",
      "steps": [
        {
          "action": "fill",
          "selector": "[data-testid=\"otp-email-input\"]",
          "value": "test@example.com"
        },
        {
          "action": "click",
          "selector": "[data-testid=\"submit-otp-send\"]"
        },
        {
          "action": "fill",
          "selector": "[data-testid=\"otp-code-input\"]",
          "value": "000000"
        },
        {
          "action": "click",
          "selector": "[data-testid=\"submit-otp-verify\"]"
        }
      ],
      "proof": "[data-testid=\"otp-error\"]",
      "why": "Mensagem de erro inline após submeter código inválido, estado distinto do step 2 limpo."
    },
    {
      "id": "forgot_locale_en",
      "base_screen": "forgot",
      "url": "/auth/forgot",
      "label": "Tela de recuperar senha em inglês",
      "steps": [
        {
          "action": "click",
          "selector": "[data-testid=\"locale-toggle\"]"
        }
      ],
      "proof": "text=Reset your password",
      "why": "Cabeçalho muda de 'Recuperar senha' para 'Reset your password', botão de 'Enviar link' para 'Send link'."
    }
  ]

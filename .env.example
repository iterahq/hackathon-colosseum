# ==============================================
# itera-player — Environment Configuration
# ==============================================
# Copy to .env and fill in. Production values live in Infisical /apps/itera
# and are injected into the Dokploy app env.

# --- Itera Supabase (separate project from DFL prod — ADR-3) ---
# Project ref: kjefmwlopzeaqgqtlbdn
VITE_SUPABASE_URL=https://kjefmwlopzeaqgqtlbdn.supabase.co
VITE_SUPABASE_ANON_KEY=your-itera-anon-key

# --- itera-api (federation token exchange; embed mode) ---
# itera-player (when framed by dfl-learn with ?embed=1) POSTs the DFL token to
# ${VITE_ITERA_API_URL}/v1/embed/session to mint an Itera session (no re-login).
VITE_ITERA_API_URL=https://api.iterahq.dev
# "Sign in with DFL" (standalone, forma 1): the DFL-side handoff page the login
# button redirects to. After a DFL login it returns to
# ${origin}/auth/dfl/callback#dfl_token=<JWT>, which we exchange for an Itera
# session via /v1/embed/session. (DFL-side handoff page is a dfl-learn change —
# see the federation plan's open DFL-side gate.)
VITE_DFL_HANDOFF_URL=https://learn.devfellowship.com/auth/federate

# --- Observability (OpenTelemetry) ---
VITE_OTEL_API_KEY=
VITE_OTEL_ENABLED=false
VITE_SENTRY_DSN=

# --- Analytics (Umami self-hospedado em analytics.devfellowship.com) ---
# Sem o id nenhuma tag é emitida. O id não é segredo (aparece no HTML de todo
# site medido); quem autoriza a escrita é o servidor do Umami, pela origem.
VITE_UMAMI_WEBSITE_ID=

# --- DB migrations (db/scripts/apply-migrations.sh) ---
# Full pooler URL; password via PGPASSWORD or embedded.
# ITERA_DB_URL=postgresql://postgres.kjefmwlopzeaqgqtlbdn@aws-1-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# --- Fellowship pilot seed (db/seeds/fellowship-pilot.ts) ---
# npm run seed:fellowship-pilot [-- --dry-run]
# ITERA_SUPABASE_URL=https://kjefmwlopzeaqgqtlbdn.supabase.co
# ITERA_SUPABASE_SERVICE_ROLE_KEY=...   # Itera service-role (writes itera.* + admin auth)
# Optional DFL read-only source (else falls back to fellowship-pilot.fixture.json):
# DFL_SUPABASE_URL=https://yoojxnggaxcqtsyjdrdx.supabase.co
# DFL_SUPABASE_SERVICE_ROLE_KEY=...     # READ-ONLY use — this seed NEVER writes DFL prod
# PILOT_EMAILS=fellow1@...,fellow2@...   # or defaults to CLAUDE_SMOKE_USERNAME

# --- E2E harness (e2e/itera-fellowship.spec.ts — manual/scheduled) ---
# ITERA_API_URL=https://api.iterahq.dev
# LEARN_BASE_URL=https://learn.devfellowship.com
# DFL_BATCH_RESULTS_API_KEY=...          # dfl-batch tenant Results-API key (NEVER commit)
# CLAUDE_SMOKE_USERNAME=...  CLAUDE_SMOKE_PASSWORD=...   # DFL-side login

# Itera Results-API base URL (itera-api) — enables the AI-generation + AI-judge
# loop on open-scope (rubric.mode='ai-judge') activities. When UNSET, those
# activities keep their read-only "Mark done" behavior (capability-probe; zero
# regression). e.g. https://api.iterahq.dev
VITE_ITERA_API_BASE=

# Internal CI launcher handoff; leave unset for local and production builds.
# This points only to the loopback socket already owned by run-source-stamp.mjs.
STAMP_MANAGED_PREVIEW_URL=

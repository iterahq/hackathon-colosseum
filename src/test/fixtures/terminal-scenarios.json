    "steps": [
      {
        "id": "criar-arquivo",
        "prompt": {
          "pt": "Crie o arquivo **perfil.md**.",
          "en": "Create the **perfil.md** file."
        },
        "hint": {
          "pt": "touch perfil.md",
          "en": "touch perfil.md"
        },
        "unlock": {
          "commandMatched": {
            "cmd": "touch perfil.md"
          }
        }
      },
      {
        "id": "salvar",
        "prompt": {
          "pt": "Prepare tudo e faça o commit — nessa ordem.",
          "en": "Stage everything and commit — in that order."
        },
        "hint": {
          "pt": "git add . e depois git commit -m \"sua mensagem\"",
          "en": "git add . then git commit -m \"your message\""
        },
        "unlock": {
          "commandSequence": {
            "ordered": true,
            "cmds": [
              {
                "cmd": "git add .",
                "accept": [
                  "git add -A",
                  "git add --all",
                  "git add perfil.md"
                ]
              },
              {
                "cmd": "git commit -m",
                "argPattern": {
                  "-m": "^.{3,}$"
                }
              }
            ]
          }
        }
      }
    ],
    "success": {
      "stepCompleted": {
        "id": "salvar"
      }
    },
    "reveal": {
      "recap": {
        "pt": "Preparar e commitar, nessa ordem — é o par que você vai repetir a vida toda. 🎉",
        "en": "Stage then commit, in that order — the pair you will repeat forever. 🎉"
      },
      "masterLine": [
        "touch perfil.md",
        "git add .",
        "git commit -m \"cria perfil\""
      ]
    }
  },

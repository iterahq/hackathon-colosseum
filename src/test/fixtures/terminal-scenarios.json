    "inputMode": "freeText",
    "initialState": {
      "engine": "git",
      "ps1": "aluno@itera:~/meu-projeto$",
      "windowTitle": "bash — sandbox",
      "welcome": [
        "Repositório pronto. Você está na branch main."
      ],
      "seed": {
        "defaultBranch": "main",
        "seedFiles": {
          "README.md": "# meu-projeto"

  "address": "ETeJkm9QrVgMuaMdAV6aLkFZGLDX6pMcniAXu8rcBqhq",
  "cluster": "devnet",
  "metadata": {
    "framework": "native (solana-program 2.1, no Anchor): the first byte of the instruction data is the discriminator",
    "source": "/verify/bounty-escrow.rs",
    "binary": "/verify/itera_bounty_escrow.so",
    "binary_sha256": "0e8db8db19ae83094aca2335a0b0f9d230d55cb8d8134a567e09808631d33f6d",
    "built_by": "GitHub Actions workflow bounty-escrow-build (cargo build-sbf, Solana toolchain 3.1.14)",
    "upgrade_authority": "read it live: getAccountInfo of the program's data account, bytes 12..45"
  },
  "constants": [
    { "name": "ITERA_ATTESTER", "type": "pubkey", "value": "AMoTUQic1C5ecYfvs3T2L5cBAZcUmCn4dPvboSdmJ3cA" },
    { "name": "MPL_CORE", "type": "pubkey", "value": "CoREENxT6tW1HoK8ypY1SxRMZTcVPm7R94rH4PZNhX7d" },
    { "name": "SEED", "type": "bytes", "value": "bounty" }
  ],
  "instructions": [
    {
      "name": "create",
      "discriminator": [0],
      "args": [
        { "name": "id", "type": { "array": ["u8", 16] } },
        { "name": "amount", "type": "u64" },
        { "name": "expires_at", "type": "i64" }
      ],
      "accounts": [
        { "name": "funder", "signer": true, "writable": true },
        { "name": "bounty", "writable": true, "pda": { "seeds": ["\"bounty\"", "id", "sponsor", "approver", "collection", "amount (u64 LE)", "expires_at (i64 LE)"] } },
        { "name": "sponsor" },
        { "name": "approver" },
        { "name": "collection" },
        { "name": "system_program", "address": "11111111111111111111111111111111" }
      ],
      "checks": "The account is the PDA of exactly these terms and does not exist; amount > 0; expiry in the future. Moves amount + rent from the funder."
    },
    {
      "name": "accept",
      "discriminator": [1],
      "args": [],
      "accounts": [
        { "name": "attester", "signer": true, "docs": "The bounty's approver, or ITERA_ATTESTER" },
        { "name": "bounty", "writable": true },
        { "name": "claimant", "signer": true },
        { "name": "certification", "docs": "The claimant's Metaplex Core asset" }
      ],
      "checks": "Open and not expired; the claimant signed; the certification account is owned by Metaplex Core, its first byte is 1 (AssetV1), bytes 1..33 (owner) equal the claimant, byte 33 is 2 (update authority = collection) and bytes 34..66 equal the collection the bounty names. Records claimant and certification."
    },
    {
      "name": "release",
      "discriminator": [2],
      "args": [],
      "accounts": [{ "name": "approver", "signer": true }, { "name": "bounty", "writable": true }, { "name": "claimant", "writable": true }],
      "checks": "Claimed, and the account passed is the recorded claimant. Pays amount, marks paid."
    },
    {
      "name": "unclaim",
      "discriminator": [3],
      "args": [],
      "accounts": [{ "name": "authority", "signer": true, "docs": "The recorded claimant, the approver, or ITERA_ATTESTER" }, { "name": "bounty", "writable": true }],
      "checks": "Claimed. Clears claimant and certification, marks open."
    },
    {
      "name": "refund",
      "discriminator": [4],
      "args": [],
      "accounts": [{ "name": "authority", "signer": true, "docs": "The approver or the sponsor; any signer once the bounty is past its expiry" }, { "name": "bounty", "writable": true }, { "name": "sponsor", "writable": true }],
      "checks": "Open, and the destination is the recorded sponsor. Pays amount, marks refunded."
    }
  ],
  "accounts": [
    {
      "name": "Bounty",
      "size": 195,
      "fields": [
        { "name": "tag", "offset": 0, "type": "u8", "docs": "always 1" },
        { "name": "bump", "offset": 1, "type": "u8" },
        { "name": "status", "offset": 2, "type": "u8", "docs": "0 open, 1 claimed, 2 paid, 3 refunded" },
        { "name": "id", "offset": 3, "type": { "array": ["u8", 16] } },
        { "name": "sponsor", "offset": 19, "type": "pubkey", "docs": "the only refund destination" },
        { "name": "approver", "offset": 51, "type": "pubkey", "docs": "the only key that can release" },
        { "name": "collection", "offset": 83, "type": "pubkey" },
        { "name": "amount", "offset": 115, "type": "u64" },
        { "name": "expires_at", "offset": 123, "type": "i64" },
        { "name": "claimant", "offset": 131, "type": "pubkey", "docs": "all zero while nobody holds the bounty" },
        { "name": "certification", "offset": 163, "type": "pubkey" }

{
  "name": "@iterahq/activities",
  "version": "0.1.0",
  "description": "Portable Itera activity renderers — render an activity outside the Itera Player.",
  "license": "UNLICENSED",
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CONTRACT.md",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iterahq/itera-player.git",
    "directory": "packages/activities"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "prepare": "tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "@iterahq/activity-spec": ">=0.8.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.23",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.462.0"
  }
}

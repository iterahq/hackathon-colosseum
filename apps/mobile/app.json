{
  "expo": {
    "name": "Itera",
    "slug": "itera-player",
    "owner": "iterahq",
    "scheme": "itera",
    "version": "0.3.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0908",
    "icon": "./assets/icon.png",
    "platforms": ["ios", "android"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tainanfidelis.iterahq",
      "associatedDomains": ["applinks:app.iterahq.dev"],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.tainanfidelis.iterahq",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {"scheme": "https", "host": "app.iterahq.dev", "path": "/login"},
            {"scheme": "https", "host": "app.iterahq.dev", "path": "/auth/forgot"},
            {"scheme": "https", "host": "app.iterahq.dev", "path": "/auth/code"},
            {"scheme": "https", "host": "app.iterahq.dev", "path": "/auth/dfl/callback"},
            {"scheme": "https", "host": "app.iterahq.dev", "path": "/"},
            {"scheme": "https", "host": "app.iterahq.dev", "path": "/catalog"},
            {"scheme": "https", "host": "app.iterahq.dev", "pathPrefix": "/program/"},
            {"scheme": "https", "host": "app.iterahq.dev", "pathPrefix": "/lesson/"},
            {"scheme": "https", "host": "app.iterahq.dev", "path": "/artifacts"},
            {"scheme": "https", "host": "app.iterahq.dev", "path": "/profile"},
            {"scheme": "https", "host": "app.iterahq.dev", "pathPrefix": "/g/"}
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#0A0908"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0908",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      ["expo-dev-client", { "addGeneratedScheme": false }],
      "expo-web-browser"
    ],
    "runtimeVersion": { "policy": "fingerprint" },
    "updates": {
      "url": "https://u.expo.dev/14894fdb-316a-4b24-a12b-ac3106ee9d6d",
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0
    },
    "extra": {
      "webOrigin": "https://app.iterahq.dev",
      "router": {},
      "eas": {
        "projectId": "14894fdb-316a-4b24-a12b-ac3106ee9d6d"
      }
    }
  }
}

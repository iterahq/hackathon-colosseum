    {"id": "code-kinds", "reason": "Monaco + sandboxed iframe", "paths": [], "kinds": ["code", "code_editor_*", "code_fill_*"]}
  ],
  "not_counted_routes": [
    {"path": "*", "reason": "NotFound, no behaviour to port"},
    {"path": "/prototipo/cena", "reason": "internal prototype"}
  ]

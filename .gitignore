# Monaco self-hosted (~16 MB) — GERADO no build por scripts/vendor-monaco.ts.
# Não commitar: é uma cópia byte-a-byte de node_modules/monaco-editor/min/vs.
/public/vendor/monaco/

# E2E proof screenshots (generated)
e2e-*-proof.png

# Worktrees de agente (não fazem parte do projeto)
/.claude/worktrees/

# TS incremental build cache (written by `tsc -b`; `npm run typecheck` uses
# --noEmit per-project and does not create these, but local `tsc -b` does).
*.tsbuildinfo

# rollback dumps de spec (dados de prod, nao versionar)
db/.rollback-*.json

# The external-consumer proof reinstalls from scratch on every run
# (`check.sh` deletes node_modules AND the lock before `npm install <tarball>`),
# so a committed lock here would be regenerated churn on every CI run and would
# never be the thing under test. The versions that matter are pinned in
# `external-consumer/package.json`.
/external-consumer/package-lock.json

# Captura do mapa de UX (gerada): `screenshot.png` + `regions.json` por tela.
# São ARTEFATOS de uma execução, não fonte — versionar um PNG binário faria
# cada rodada virar diff. O que é versionado é o código que os produz
# (`e2e/support/captureRegions.ts`) e a prova de que ele repete byte a byte
# (`e2e/capture-regions.spec.ts`). Cópias para consumo humano vão pro
# media.devfellowship.com e são linkadas na PR.
/e2e/artifacts/

# Written by scripts/ux-capture/run-capture.sh while it serves the preview.
preview.log
# The pre-pass output is an INPUT to authoring the manifest, never a committed
# artifact — e2e/support/capture-manifest.json is what survives.
/prepass.json

# Bundled output of scripts/ux-capture (see its README — tsx cannot run those scripts).
/.capture-build/

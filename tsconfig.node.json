{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true
  },
  /* `scripts/ux-capture/*.ts` is deliberately NOT here. Those two drive
     Playwright and import `e2e/support/captureRegions.ts`, whose
     `page.evaluate` bodies are DOM code — and this project has no DOM lib, by
     design, because everything else under `scripts/` is a build-time Node
     tool. They are typechecked by `tsconfig.e2e.json`, which already owns the
     harness they belong to. */
  "include": ["vite.config.ts", "vitest.config.ts", "scripts/**/*.ts"],
  "exclude": ["scripts/ux-capture/*.ts"]
}

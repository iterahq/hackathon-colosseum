# This project installs `@iterahq/activities` from a PACKED TARBALL, so it never
# asks a registry for it. The scope mapping is here anyway, and it is not
# decoration: without it a stray `npm install @iterahq/...` in this directory
# would silently go to npmjs — npm reads `.npmrc` from the CURRENT directory and
# from $HOME, it does NOT walk up to the repo root, which is exactly how the
# first run of check.sh ended up asking npmjs for a private package.
@iterahq:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}

# Do not auto-install peer dependencies.
#
# `@iterahq/activity-spec` is a peer of `@iterahq/activities`, and it is a
# TYPES-ONLY peer — `dist/**/*.js` contains no import of it (the only reference
# is an erased `import type { ActivityKind }`). Pulling a private package this
# harness never executes would make a PORTABILITY check depend on registry
# credentials, and then a revoked token would read as "the extraction broke".
#
# Whether a clean project can resolve `@iterahq/*` from GitHub Packages is a
# real question, and it already has its own answer: the `registry-resolution`
# job in ci.yml, which proves it against an empty npm cache.
legacy-peer-deps=true
